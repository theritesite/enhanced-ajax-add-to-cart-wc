	"keywords": ["wordpress", "plugin", "woocommerce", "ajax", "add-to-cart"],
	"homepage": "https://www.theritesites.com/plugins/enhanced-ajax-add-to-cart-wc",
	"license": "GPL-2.0-or-later",
	"authors": [
	{
		"name": "TheRiteSites",
		"homepage": "https://www.theritesites.com"
	}
	],
	"type": "wordpress-plugin",
	"autoload": {
		"classmap": ["enhanced-ajax-add-to-cart-wc.php", "includes/", "woo-includes/"]
	},
	"require": {

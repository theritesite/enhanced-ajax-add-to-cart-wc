{
	"name": "enhanced-ajax-add-to-cart-wc",
	"version": "2.4.0",
	"description": "Creates a shortcode or block for you to be able to add an AJAX button with an associated quantity for you WooCommerce Product",
	"main": "public/js/index.js",
	"author": "theritesites",
	"license": "GPLv2",
	"private": true,
	"files": [
		"assets",
		"woo-includes",
		"includes",
		"build",
		"languages",
		"index.php",
		"enhanced-ajax-add-to-cart-wc.php",
		"LICENSE.txt",
		"README.txt",
		"uninstall.php"
	],
	"scripts": {
		"dev": "wp-scripts start --mode=development --env LOC=m1",
		"build": "npm run clean && wp-scripts build --mode=production",
		"package": "npm run build && node ../trs-package.js",
		"deploy": "npm run package && node ../trs-deliver.js m1",
		"clean": "rm -rf build/* zip_files/*",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"test:e2e": "wp-scripts test-e2e",
		"test:unit": "wp-scripts test-unit-js"
	},
	"devDependencies": {
		"@woocommerce/settings": "^1.0.0",
		"@wordpress/api-fetch": "^7.52.0",
		"@wordpress/block-editor": "^16.1.0",
		"@wordpress/blocks": "^15.25.0",
		"@wordpress/components": "^38.0.0",
		"@wordpress/compose": "^8.5.0",
		"@wordpress/data": "^10.52.0",
		"@wordpress/dependency-extraction-webpack-plugin": "^6.52.0",
		"@wordpress/element": "^8.4.0",
		"@wordpress/html-entities": "^4.52.0",
		"@wordpress/i18n": "^6.25.0",
		"@wordpress/scripts": "^34.0.0",
		"@wordpress/url": "^4.52.0",
		"ansi-colors": "^4.1.3",
		"classnames": "^2.5.1",
		"copy-webpack-plugin": "^14",
		"expect": "^30.4.1",
		"gridicons": "^3.4.3",
		"i18n-calypso": "^8.1.0",
		"lodash": "^4.18.1",
		"prop-types": "^15.8.1",
		"react": "^18.3.1",
		"react-beautiful-dnd": "^13.1.1",
		"react-dom": "^18.3.1",
		"react-redux": "^9.3.0",
		"react-transition-group": "^4.4.5",
		"redux": "^5.0.1",
		"redux-mock-store": "^1.5.5",
		"redux-promise-middleware": "^6.2.0",
		"redux-thunk": "^3.1.0"
	},
	"trsPackage": {
		"slug": "enhanced-ajax-add-to-cart-for-woocommerce",
		"mainFile": "enhanced-ajax-add-to-cart-wc.php",
		"versionConstants": [
			"ENHANCED_AJAX_ADD_TO_CART"
		],
		"include": [
			"assets",
			"build",
			"languages",
			"includes",
			"woo-includes",
			"README.txt",
			"LICENSE.txt",
			"enhanced-ajax-add-to-cart-wc.php",
			"index.php",
			"uninstall.php"
		]
	}
}
